# ═══════════════════════════════════════════════════════════════════════════
# NexusIQ — Google Gemini provider preset   ⚠️  ADVANCED / OPT-IN  ⚠️
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  SCHEMA CHANGE REQUIRED before use.                                    │
# │                                                                         │
# │  Gemini's text-embedding-004 produces 768-dim vectors. AEON-IQ's       │
# │  pgvector column defaults to vector(1536). You MUST patch the schema   │
# │  BEFORE the database is first initialised. Full procedure:             │
# │                                                                         │
# │    1. Pre-vendor AEON-IQ so you can edit the migration:                │
# │         git clone https://github.com/adaptiveliquidity/AEON-IQ.git \   │
# │             vendor/aeon-iq                                             │
# │       (or: export NEXUSIQ_VENDOR_AEON=/path/to/your/AEON-IQ checkout) │
# │                                                                         │
# │    2. Edit vendor/aeon-iq/migrations/0001_initial.sql                  │
# │       and change every  vector(1536)  →  vector(768).                  │
# │                                                                         │
# │    3. cp .env.gemini.example .env                                      │
# │    4. Set OPENAI_API_KEY to your Gemini API key (see note below).      │
# │    5. ./install.sh   — detects the existing vendor/aeon-iq dir,        │
# │       skips cloning, and initialises the DB at the correct dimension.  │
# │                                                                         │
# │  If you already have a running stack, drop the DB volume first:        │
# │    docker compose down -v && ./install.sh                              │
# └─────────────────────────────────────────────────────────────────────────┘
#
# NOTE: AEON-IQ reads the provider credential from the OPENAI_API_KEY variable
# regardless of provider (single "upstream key" slot). For the gemini provider,
# put your Google AI Studio / Gemini API key in OPENAI_API_KEY.
#
# Gemini exposes an OpenAI-compatible surface; the base URL below targets it.
# Gemini DOES serve embeddings, so a single base URL covers both lanes.
# ═══════════════════════════════════════════════════════════════════════════

# ── Secrets (auto-generated by install.sh — leave blank) ──
POSTGRES_USER=nexusiq
POSTGRES_DB=nexusiq
POSTGRES_PASSWORD=
MANAGEMENT_API_KEY=
NEXUS_AEON_HMAC_KEY=
NEXUS_AGENTD_AUTH_TOKEN=

# Run the Nexus containers as this host user so ./data stays writable from the host.
# install.sh sets these to your current id -u / id -g automatically.
NEXUSIQ_UID=1000
NEXUSIQ_GID=1000

# ── Provider: Gemini (OpenAI-compatible endpoint) ──
UPSTREAM_PROVIDER=gemini
UPSTREAM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EXTRACTOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

EXTRACTOR_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004

# ── EMBEDDING_DIMENSION: must match the model AND the pgvector schema ──
# text-embedding-004 produces 768-dim vectors. This preset sets 768 to match.
# You MUST also edit migrations/0001_initial.sql (vector(1536) → vector(768))
# BEFORE the first `./install.sh` run — see the header warning above.
EMBEDDING_DIMENSION=768

# REQUIRED: put your Gemini API key here (single upstream-key slot).
OPENAI_API_KEY=

# ── Nexus client ──
NEXUS_AEON_ENABLED=true
NEXUS_AEON_BASE_URL=http://aeon:8080
