# ═══════════════════════════════════════════════════════════════════════════
# NexusIQ — OpenAI provider preset
#
#     cp .env.openai.example .env
#     ./scripts/install.sh
#     # set OPENAI_API_KEY
#     docker compose up -d
# ═══════════════════════════════════════════════════════════════════════════

# ── Secrets (auto-generated by install.sh — leave blank) ──
POSTGRES_USER=nexusiq
POSTGRES_DB=nexusiq
POSTGRES_PASSWORD=
MANAGEMENT_API_KEY=
NEXUS_AEON_HMAC_KEY=
NEXUS_AGENTD_AUTH_TOKEN=

# Run the Nexus containers as this host user so ./data stays writable from the host.
# install.sh sets these to your current id -u / id -g automatically.
NEXUSIQ_UID=1000
NEXUSIQ_GID=1000

# ── Provider: OpenAI ──
UPSTREAM_PROVIDER=openai
UPSTREAM_BASE_URL=https://api.openai.com
EMBEDDING_BASE_URL=https://api.openai.com
EXTRACTOR_BASE_URL=https://api.openai.com

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EXTRACTOR_MODEL=gpt-4o-mini

# REQUIRED.
OPENAI_API_KEY=

# ── Nexus client ──
NEXUS_AEON_ENABLED=true
NEXUS_AEON_BASE_URL=http://aeon:8080
