# ═══════════════════════════════════════════════════════════════════════════
# NexusIQ — Anthropic provider preset
#
#     cp .env.anthropic.example .env
#     ./install.sh
#     # set OPENAI_API_KEY to your Anthropic API key (see note below)
#     docker compose up -d
#
# NOTE: AEON-IQ reads the provider credential from the OPENAI_API_KEY variable
# regardless of provider (it is the single "upstream key" slot). For the
# anthropic provider, put your Anthropic API key in OPENAI_API_KEY.
#
# EMBEDDINGS: Anthropic does not serve an embeddings endpoint. Point
# EMBEDDING_BASE_URL at a provider that does (e.g. OpenAI) and keep
# EMBEDDING_DIMENSION matched to that embedding model (1536 for
# text-embedding-3-small). Chat/extraction go to Anthropic; embeddings go to
# the embedding endpoint you configure.
# ═══════════════════════════════════════════════════════════════════════════

# ── Secrets (auto-generated by install.sh — leave blank) ──
POSTGRES_USER=nexusiq
POSTGRES_DB=nexusiq
POSTGRES_PASSWORD=
MANAGEMENT_API_KEY=
NEXUS_AEON_HMAC_KEY=
NEXUS_AGENTD_AUTH_TOKEN=

# Run the Nexus containers as this host user so ./data stays writable from the host.
# install.sh sets these to your current id -u / id -g automatically.
NEXUSIQ_UID=1000
NEXUSIQ_GID=1000

# ── Provider: Anthropic (chat / extraction) ──
UPSTREAM_PROVIDER=anthropic
UPSTREAM_BASE_URL=https://api.anthropic.com
EXTRACTOR_BASE_URL=https://api.anthropic.com
EXTRACTOR_MODEL=claude-3-5-haiku-latest

# ── Embeddings (Anthropic has none — use an OpenAI-compatible embedder) ──
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# REQUIRED: put your Anthropic API key here (single upstream-key slot).
OPENAI_API_KEY=

# ── Nexus client ──
NEXUS_AEON_ENABLED=true
NEXUS_AEON_BASE_URL=http://aeon:8080
