# NexusIQ minimal core-mode configuration
#
# This is the smallest supported keyless installation:
#
#   cp .env.minimal.example .env
#   ./install.sh --start
#   ./doctor.sh
#
# No model/provider credential is required. install.sh fills the blank
# internal agentd token with cryptographically random material.

NEXUS_AEON_ENABLED=false

# Internal authentication between nexus-mcp and nexus-agentd.
NEXUS_AGENTD_AUTH_TOKEN=

# Authentication may never be weakened, even when the memory services are off.
ALLOW_UNAUTH_MANAGEMENT=false

# install.sh records the invoking host identity here.
NEXUSIQ_UID=1000
NEXUSIQ_GID=1000

# To enable memory, start from .env.example, configure a supported provider,
# set NEXUS_AEON_ENABLED=true, and re-run ./install.sh then ./start.sh.
