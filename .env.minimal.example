# ═══════════════════════════════════════════════════════════════════════════
# NexusIQ — MINIMAL config
#
# The smallest viable .env. Everything not listed here falls back to the
# defaults baked into docker-compose.yml. Steps:
#
#     cp .env.minimal.example .env
#     ./scripts/install.sh     # fills the blank secrets below
#     # set OPENAI_API_KEY
#     docker compose up -d
# ═══════════════════════════════════════════════════════════════════════════

# Postgres identity (password auto-generated by install.sh).
POSTGRES_USER=nexusiq
POSTGRES_DB=nexusiq
# auto-generated by install.sh — leave blank
POSTGRES_PASSWORD=

# Shared AEON management secret (Nexus reuses it as NEXUS_AEON_MANAGEMENT_KEY).
# auto-generated by install.sh — leave blank
MANAGEMENT_API_KEY=

# Nexus → AEON signing + agentd auth (auto-generated by install.sh).
# auto-generated by install.sh — leave blank
NEXUS_AEON_HMAC_KEY=
# auto-generated by install.sh — leave blank
NEXUS_AGENTD_AUTH_TOKEN=

# Run the Nexus containers as this host user so ./data stays writable from the host.
# install.sh sets these to your current id -u / id -g automatically.
NEXUSIQ_UID=1000
NEXUSIQ_GID=1000

# REQUIRED: OpenAI API key for the default provider.
OPENAI_API_KEY=
