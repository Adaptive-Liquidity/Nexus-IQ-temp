# ═══════════════════════════════════════════════════════════════════════════
# NexusIQ — Ollama (local LLM) preset   ⚠️  ADVANCED / EXPERIMENTAL  ⚠️
#
# This preset wires AEON-IQ to a locally-running Ollama daemon via its
# OpenAI-compatible API. It is NOT one of the first-class providers
# (openai | anthropic | gemini) and requires a SCHEMA CHANGE to work — read the
# big warning below before using it.
#
#     cp .env.ollama.example .env
#     ./scripts/install.sh
#     docker compose up -d
# ═══════════════════════════════════════════════════════════════════════════
#
# ┌───────────────────────────────────────────────────────────────────────────┐
# │  ⚠️  EMBEDDING DIMENSION MISMATCH — REQUIRES A SCHEMA CHANGE  ⚠️           │
# │                                                                           │
# │  Local embedding models do NOT produce 1536-dim vectors:                  │
# │      • nomic-embed-text   → 768 dimensions                                │
# │      • mxbai-embed-large  → 1024 dimensions                               │
# │      • all-minilm         → 384 dimensions                                │
# │                                                                           │
# │  AEON-IQ's pgvector column is HARD-CODED to vector(1536) in               │
# │      migrations/0001_initial.sql                                          │
# │                                                                           │
# │  So you MUST do BOTH of the following, consistently:                      │
# │    1. Set EMBEDDING_DIMENSION below to your model's real dimension.       │
# │    2. Change the vector(1536) column(s) in 0001_initial.sql to match      │
# │       (e.g. vector(768) for nomic-embed-text) BEFORE the database is      │
# │       first initialized. Changing it after data exists requires dropping  │
# │       / re-migrating the embedding column.                                │
# │                                                                           │
# │  If EMBEDDING_DIMENSION and the pgvector column width disagree, inserts   │
# │  will FAIL at runtime. This is why Ollama is marked EXPERIMENTAL.         │
# └───────────────────────────────────────────────────────────────────────────┘
#
# HOST NETWORKING: from inside the container, the host's Ollama daemon is
# reachable at `host.docker.internal`. On Linux you may need to add an
# extra_hosts entry (host-gateway) in a compose override; on Docker Desktop
# (macOS/Windows/WSL2) host.docker.internal resolves out of the box.

# ── Secrets (auto-generated by install.sh — leave blank) ──
POSTGRES_USER=nexusiq
POSTGRES_DB=nexusiq
POSTGRES_PASSWORD=
MANAGEMENT_API_KEY=
NEXUS_AEON_HMAC_KEY=
NEXUS_AGENTD_AUTH_TOKEN=

# Run the Nexus containers as this host user so ./data stays writable from the host.
# install.sh sets these to your current id -u / id -g automatically.
NEXUSIQ_UID=1000
NEXUSIQ_GID=1000

# ── Provider: Ollama (OpenAI-compatible local endpoint) ──
# UPSTREAM_PROVIDER stays `openai` — AEON speaks the OpenAI wire format to
# Ollama's /v1 surface. (There is no dedicated `ollama` provider value.)
UPSTREAM_PROVIDER=openai
UPSTREAM_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EXTRACTOR_BASE_URL=http://host.docker.internal:11434/v1

# Pick models you have pulled locally (`ollama pull <model>`).
EXTRACTOR_MODEL=llama3.1
EMBEDDING_MODEL=nomic-embed-text

# ⚠️ MUST match EMBEDDING_MODEL's real width AND the pgvector column.
# 768 is correct for nomic-embed-text. See the warning block above.
EMBEDDING_DIMENSION=768

# Ollama ignores the key but AEON still sends one — use a non-empty dummy.
OPENAI_API_KEY=ollama

# ── Nexus client ──
NEXUS_AEON_ENABLED=true
NEXUS_AEON_BASE_URL=http://aeon:8080
